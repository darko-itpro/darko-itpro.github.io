---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog-fr');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} lang="fr">
  <header class="mb-10">
    <p class="text-xs text-mchiato-overlay1 mb-2">[{post.data.date.toISOString().slice(0, 10)}]</p>
    <h1 class="text-xl font-bold text-mchiato-text leading-snug mb-3">
      {post.data.title}
    </h1>
    <div class="flex flex-wrap gap-2">
      {post.data.tags.map(tag => (
        <span class="text-xs border border-mchiato-surface1 px-2 py-0.5 text-mchiato-overlay1">
          #{tag}
        </span>
      ))}
    </div>
  </header>

  <article class="prose prose-mchiato prose-sm max-w-none">
    <Content />
  </article>
</BaseLayout>
