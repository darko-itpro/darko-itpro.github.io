---
import { SITE, BIO } from '../config';

interface Props {
  lang: 'en' | 'fr';
}
const { lang } = Astro.props;
const bio = BIO[lang];
const nameLen = SITE.name.length;
---

<section class="mb-14">
  <p class="text-xs text-mchiato-overlay1 mb-2">
    <span class="text-mchiato-overlay0">~/darko</span>
    <span class="text-mchiato-peach ml-1">❯</span>
    <span class="text-mchiato-peach ml-1">whoami</span>
  </p>

  <div class="pl-4 border-l-2 border-mchiato-peach">
    <h1 class="text-2xl font-medium text-mchiato-text tracking-tight">
      <span class="animate-typing" style={`--type-len: ${nameLen}ch; --type-steps: ${nameLen};`}>{SITE.name}</span><span class="cursor-blink text-mchiato-peach" style="animation-delay: 0.6s">█</span>
    </h1>
    <p class="text-sm text-mchiato-peach mt-1">{bio.tagline}</p>
    <p class="text-sm text-mchiato-subtext0 mt-3 leading-relaxed max-w-lg">
      {bio.description}
    </p>

    <div class="flex gap-5 mt-5 text-xs text-mchiato-overlay1">
      <a href={SITE.github} target="_blank" rel="noopener"
         class="hover:text-mchiato-peach transition-colors flex items-center gap-1">
        ↗ github
      </a>
      <a href={SITE.linkedin} target="_blank" rel="noopener"
         class="hover:text-mchiato-peach transition-colors flex items-center gap-1">
        ↗ linkedin
      </a>
      <span>{SITE.location}</span>
    </div>
  </div>
</section>
