---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang: 'en' | 'fr';
  limit?: number;
  full?: boolean;
}
const { lang, limit = 5, full = false } = Astro.props;

const collectionId = lang === 'fr' ? 'blog-fr' : 'blog-en';
const label = lang === 'fr'
  ? { cmd: full ? '❯ cat blog.log' : `❯ tail -n ${limit} blog.log`, all: 'voir tous les articles →' }
  : { cmd: full ? '❯ cat blog.log' : `❯ tail -n ${limit} blog.log`, all: 'all posts →' };

const allPosts = (await getCollection(collectionId))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const posts = full ? allPosts : allPosts.slice(0, limit);

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<section class="mb-14">
  <p class="text-xs text-mchiato-overlay1 mb-3">
    <span class="text-mchiato-overlay0">~/darko</span>
    <span class="text-mchiato-peach ml-1">{label.cmd}</span>
  </p>

  <ul class="divide-y divide-mchiato-surface0">
    {posts.map(post => (
      <li>
        <a href={getRelativeLocaleUrl(lang, `/blog/${post.id}/`)}
           class="flex flex-col gap-0.5 py-2.5 group hover:pl-2 transition-all duration-150">
          <span class="text-xs text-mchiato-overlay1">
            [{formatDate(post.data.date)}]
          </span>
          <span class="text-sm text-mchiato-subtext1 group-hover:text-mchiato-peach transition-colors leading-snug">
            {post.data.title}
          </span>
          {full && <span class="text-xs text-mchiato-overlay1">{post.data.description}</span>}
        </a>
      </li>
    ))}
  </ul>

  {!full && (
    <a href={getRelativeLocaleUrl(lang, '/blog/')}
       class="inline-block mt-3 text-xs text-mchiato-subtext0 hover:text-mchiato-peach transition-colors">
      {label.all}
    </a>
  )}
</section>
