---
import { getCollection } from 'astro:content';
import { TRAINING_TOPICS, TRAINING_TOPIC_LABELS } from '../config';

interface Props {
  lang: 'en' | 'fr';
}
const { lang } = Astro.props;

const collectionId = lang === 'fr' ? 'trainings-fr' : 'trainings-en';
const label = lang === 'fr'
  ? { cmd: '❯ ls -la ./formations/', empty: 'Aucune formation pour le moment.' }
  : { cmd: '❯ ls -la ./trainings/', empty: 'No trainings yet.' };

const trainings = (await getCollection(collectionId))
  .sort((a, b) => a.data.order - b.data.order);

const topics: { topic: string; items: typeof trainings }[] = [];
for (const training of trainings) {
  let group = topics.find(t => t.topic === training.data.topic);
  if (!group) {
    group = { topic: training.data.topic, items: [] };
    topics.push(group);
  }
  group.items.push(training);
}

topics.sort((a, b) => {
  const ai = TRAINING_TOPICS.indexOf(a.topic);
  const bi = TRAINING_TOPICS.indexOf(b.topic);
  if (ai === -1 && bi === -1) return 0;
  if (ai === -1) return 1;
  if (bi === -1) return -1;
  return ai - bi;
});
---

<section class="mb-14">
  <p class="text-xs text-mchiato-overlay1 mb-3">
    <span class="text-mchiato-overlay0">~/darko</span>
    <span class="text-mchiato-peach ml-1">{label.cmd}</span>
  </p>

  {topics.length === 0 && (
    <p class="text-sm text-mchiato-overlay1 pl-2">{label.empty}</p>
  )}

  {topics.map(group => (
    <div class="mb-6 last:mb-0">
      <p class="text-xs text-mchiato-peach mb-1"># {TRAINING_TOPIC_LABELS[group.topic]?.[lang] ?? group.topic}</p>
      <ul class="divide-y divide-mchiato-surface0">
        {group.items.map(training => (
          <li>
            <a href={training.data.docsUrl}
               target="_blank"
               rel="noopener"
               class="flex items-baseline gap-3 py-2 group hover:pl-2 transition-all duration-150">
              <span class="text-xs text-mchiato-overlay0 min-w-[90px] shrink-0">
                drwxr-xr-x
              </span>
              <span class="text-sm text-mchiato-peach group-hover:opacity-80 transition-opacity flex-1">
                {training.data.title}/
              </span>
              <span class="text-xs text-mchiato-overlay1 shrink-0">
                docs ↗
              </span>
            </a>
            <p class="text-xs text-mchiato-subtext0 pl-[102px] pb-2 leading-relaxed">
              {training.data.description}
            </p>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
